{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:streamer-rf:I1-GLOBAL-SOURCE-1.0",
  "title": "I1 conservative global/local free-source manifest",
  "type": "object",
  "required": ["version", "geometry_id", "mesh_id", "operator_id", "boundary_id", "reference_plane_id", "accepted_state_id", "species_model_id", "parameter_source_class", "source_hash", "build_hash", "config_hash", "units", "time_interval", "time_layer", "includes_displacement_current", "secondary_emission_in_net_electron_flux", "secondary_emission_added_as_source", "negative_ion_transport", "capacitance_owner", "capacitance_copies", "external_return", "external_branches", "surface_charge", "electrode_exchange", "electrode_storage", "port_charge"],
  "properties": {
    "version": {"const": "I1-GLOBAL-SOURCE-1.0"},
    "geometry_id": {"type": "string", "minLength": 1},
    "mesh_id": {"type": "string", "minLength": 1},
    "operator_id": {"type": "string", "minLength": 1},
    "boundary_id": {"type": "string", "minLength": 1},
    "reference_plane_id": {"type": "string", "minLength": 1},
    "accepted_state_id": {"type": "string", "minLength": 1},
    "species_model_id": {"type": "string", "minLength": 1},
    "parameter_source_class": {"enum": ["A", "B", "C", "D"]},
    "source_hash": {"type": "string", "minLength": 1},
    "build_hash": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "units": {"const": {"length": "m", "time": "s", "charge": "C", "current": "A", "J": "A/m2", "rho": "C/m3", "volume": "m3"}},
    "time_interval": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "time_layer": {"enum": ["ACCEPTED_INTERVAL_PRE_FLUX", "ACCEPTED_SYNTHETIC_TIME_SERIES"]},
    "includes_displacement_current": {"const": false},
    "secondary_emission_in_net_electron_flux": {"const": true},
    "secondary_emission_added_as_source": {"const": false},
    "negative_ion_transport": {"enum": ["IMMOBILE_BY_MODEL", "NOT_APPLICABLE"]},
    "capacitance_owner": {"enum": ["TOTAL_CHARGE", "SPLIT_GEOMETRIC_CAPACITANCE"]},
    "capacitance_copies": {"const": 1},
    "external_return": {"type": ["object", "null"]},
    "external_branches": {"type": ["object", "null"]},
    "surface_charge": {"type": ["object", "null"]},
    "electrode_exchange": {"type": ["object", "null"]},
    "electrode_storage": {"type": ["object", "null"]},
    "port_charge": {"type": ["object", "null"]},
    "missing_reasons": {"type": "object", "additionalProperties": {"type": "string"}},
    "authoritative_faces": {"type": "object"},
    "gas_charge_pre_post": {"type": "object"},
    "local_port_ledger": {"type": "object"},
    "numerical_correction": {"type": "object"},
    "physical_source": {"type": "object"},
    "outer_exchange": {"type": "object"}
  },
  "$comment": "JSON shape is not conservation proof. I1GlobalSourceAssembler additionally checks same reference/time identities, finite arrays, face integrals, independent node charge, surface mapping and port balance. Null global fields only permit LOCAL_GAS_ONLY. No actual receiver transfer is supplied."
}
